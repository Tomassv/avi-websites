# Copy to .env.local for `npm run dev`. On Vercel, set these in the project settings.
# Secrets: openssl rand -base64 32

PUBLIC_BASE_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=avilabs.is
# Optional: only these people (inside the domain) may sign in. Empty = the whole domain.
ALLOWED_EMAILS=

TOKEN_SECRETS=
COMMIT_SIGNING_SECRET=

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_REPO=owner/avi-websites

# Upstash Redis (set by the Vercel Marketplace integration)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# The "marketing-previews" Protection Bypass for Automation secret of cura's Vercel project
PREVIEW_BYPASS_SECRET_CURA_AERO=

# true: publish waits for an approving PR review
REQUIRE_APPROVAL=false

# Local development only
DEV_MODE=1
# In-memory GitHub (a copy of this checkout) and store; nothing is written anywhere
DRY_RUN=1
REDIS=memory
DRY_RUN_PREVIEW_URL=

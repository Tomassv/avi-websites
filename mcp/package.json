{
  "name": "avi-websites-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that lets AviLabs marketers change the websites from Claude",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "gen:rules": "node scripts/gen-rules.mjs",
    "build": "npm run gen:rules && tsc --noEmit",
    "dev": "npm run gen:rules && tsx watch src/dev.ts",
    "dev:token": "tsx scripts/dev-token.ts",
    "revoke": "tsx scripts/revoke.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run gen:rules",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@modelcontextprotocol/server": "2.2.0",
    "@octokit/auth-app": "8.3.1",
    "@octokit/rest": "22.0.1",
    "@upstash/redis": "1.39.0",
    "ajv": "8.20.0",
    "hono": "4.13.12",
    "jose": "6.2.12",
    "sharp": "0.35.5",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
